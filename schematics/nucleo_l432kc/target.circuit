    net PA6 = jumper_pa6_pb6.P1, target_mcu.PA6, port.PA6;
    net PA7 = target_mcu.PA7, port.PA7;
    net PA8 = target_mcu.PA8, port.PA8;
    net PA9 = target_mcu.PA9, port.PA9;
    net PB0 = target_mcu.PB0, port.PB0;
    net PB1 = target_mcu.PB1, port.PB1;
    net PB3 = jumper_pb3.P2, target_mcu.PB3, port.PB3;
    net PB4 = target_mcu.PB4, port.PB4;
    net PB5 = target_mcu.PB5, port.PB5;
    net PB6 = jumper_pa6_pb6.P2, target_mcu.PB6, port.PB6;
    net PB7 = jumper_pa5_pb7.P2, target_mcu.PB7, port.PB7;
    net PF0 = jumper_pf0.P1, port.PF0;
    net PF1 = jumper_pf1.P1, port.PF1;
    net VDD =
