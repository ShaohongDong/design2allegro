                pins = [pin(stlink.jumper_pa15_stlink_tx.P1), pin(stlink.jumper_pa15_stlink_tx.P2)];
                role = "jumper";
            }
        ];
    }
    rule "TARGET_RESET" path [pin(stlink.debug_mcu.PB0)] {
        target = pin(target.target_mcu.NRST);
