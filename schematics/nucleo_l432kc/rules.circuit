    rule "VCP_TX" path [pin(target.target_mcu.PA2)] {
        target = pin(stlink.debug_mcu.PA3);
        via = [
            {
                pins = [pin(stlink.jumper_pa2_stlink_rx.P1), pin(stlink.jumper_pa2_stlink_rx.P2)];
                role = "jumper";
            }
        ];
