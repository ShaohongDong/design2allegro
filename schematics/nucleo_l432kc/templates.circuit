}

template diode_bat60jfilm {
    assembly = "fitted";
    device = "BAT60JFILM.0d63fc0e";
    package = "SOD-323";
    properties = { type = "Schottky"; current_rating = 3 A; voltage_rating = 10 V; rating_conditions = "3 A repetitive peak at duty factor 0.11, not continuous current; VRRM 10 V; thermal derating per BAT60 datasheet."; };

}

