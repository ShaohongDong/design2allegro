circuit 2;

template connector_15 {
    assembly = "fitted";
    device = "wuerth.61301511121";
    package = "HDR_1x15_2R54_V_F";
    properties = { pitch = 2.54 mm; positions = 15; current_rating = 3 A; voltage_rating = 250 V; rating_conditions = "Working voltage AC; connector rating is not the board rail rating."; };
}

template capacitor_1_uf {
    assembly = "fitted";
    device = "CC0603KRX5R7BB105.9db21403";
    package = "0603C";
    properties = { dielectric = "X5R"; polarized = false; tolerance = 10 %; voltage_rating = 16 V; };
}

