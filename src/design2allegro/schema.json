{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/design",
  "$defs": {
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "part": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "pin": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "part",
            "pin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "part": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "group": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "part",
            "group"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "instance": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "instance",
            "port"
          ],
          "additionalProperties": false
        }
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "INPUT",
            "OUTPUT",
            "BIDIR",
            "TRISTATE",
            "PASSIVE",
            "UNSPEC",
            "PWRIN",
            "PWROUT",
            "OPENCOLL",
            "OPENEMIT",
            "PULLUP",
            "PULLDN",
            "NOCONNECT",
            "FREE"
          ]
        },
        "electrical": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+-]+$"
        },
        "value": {
          "type": "string"
        },
        "pins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/pin"
          },
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+$"
            },
            "minItems": 1
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "electrical": {
          "type": "object"
        }
      },
      "required": [
        "package",
        "pins"
      ],
      "additionalProperties": false
    },
    "library": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/component"
          },
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "required": [
        "version",
        "components"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "width"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "parts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": {
                "type": "string"
              },
              "electrical": {
                "type": "object"
              }
            },
            "required": [
              "component"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "instances": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "module"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "nets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "endpoints": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/endpoint"
                },
                "minItems": 1
              },
              "electrical": {
                "type": "object"
              }
            },
            "required": [
              "endpoints"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "nc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "attribute",
            "bank",
            "capability",
            "connected",
            "ddr",
            "differential",
            "drive",
            "interface",
            "isolated",
            "no_connect",
            "path",
            "power",
            "pull",
            "required",
            "state",
            "voltage"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "selector": {
          "type": "object",
          "properties": {
            "entity": {
              "enum": [
                "pins",
                "parts",
                "nets"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "entity",
            "pattern"
          ],
          "additionalProperties": false
        },
        "params": {
          "type": "object"
        },
        "required": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "applicable": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "scope"
          ],
          "not": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "required": [
            "selector"
          ],
          "not": {
            "required": [
              "scope"
            ]
          }
        }
      ]
    },
    "rules": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "properties": {
            "parts": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 0
            },
            "pins": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 0
            },
            "nets": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0
        }
      },
      "required": [
        "version",
        "rules"
      ],
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "rule",
        "object",
        "reason",
        "owner"
      ],
      "additionalProperties": false
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      },
      "minItems": 0
    },
    "design": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/module"
          },
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "top": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "references": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/rules"
            }
          ]
        },
        "waivers": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/waivers"
            }
          ]
        }
      },
      "required": [
        "version",
        "libraries",
        "modules",
        "top",
        "references"
      ],
      "additionalProperties": false
    }
  }
}
