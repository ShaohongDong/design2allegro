{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/design",
  "$defs": {
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "part": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "pin": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "part",
            "pin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "part": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "group": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "part",
            "group"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "instance": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "instance",
            "port"
          ],
          "additionalProperties": false
        }
      ]
    },
    "pin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "INPUT",
            "OUTPUT",
            "BIDIR",
            "TRISTATE",
            "PASSIVE",
            "UNSPEC",
            "PWRIN",
            "PWROUT",
            "OPENCOLL",
            "OPENEMIT",
            "PULLUP",
            "PULLDN",
            "NOCONNECT",
            "FREE"
          ]
        },
        "electrical": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "width"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "parts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "device": {
                "type": "string",
                "minLength": 1
              },
              "package": {
                "type": "string",
                "minLength": 1
              },
              "properties": {
                "type": "object"
              },
              "electrical": {
                "type": "object"
              },
              "assembly": {
                "enum": [
                  "fitted",
                  "dnp"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "identity_namespace": {
                "type": "string",
                "pattern": "^(?:[A-Za-z][A-Za-z0-9_-]*(?:/[A-Za-z][A-Za-z0-9_-]*)*)?$"
              }
            },
            "required": [
              "id",
              "device",
              "package",
              "assembly"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "instances": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              }
            },
            "required": [
              "module",
              "id"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "nets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "endpoints": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/endpoint"
                },
                "minItems": 1
              },
              "electrical": {
                "type": "object"
              }
            },
            "required": [
              "endpoints"
            ],
            "additionalProperties": false
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "nc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "attribute",
            "bank",
            "capability",
            "connected",
            "ddr",
            "differential",
            "drive",
            "interface",
            "isolated",
            "no_connect",
            "path",
            "power",
            "pull",
            "required",
            "state",
            "voltage",
            "isolated_all"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "selector": {
          "type": "object",
          "properties": {
            "entity": {
              "enum": [
                "pins",
                "parts",
                "nets"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "entity",
            "pattern"
          ],
          "additionalProperties": false
        },
        "params": {
          "type": "object"
        },
        "required": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "applicable": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "scope"
          ],
          "not": {
            "required": [
              "selector"
            ]
          }
        },
        {
          "required": [
            "selector"
          ],
          "not": {
            "required": [
              "scope"
            ]
          }
        }
      ]
    },
    "rules": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "properties": {
            "parts": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 0
            },
            "pins": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 0
            },
            "nets": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "minProperties": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0
        }
      },
      "required": [
        "version",
        "rules"
      ],
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "rule",
        "object",
        "reason",
        "owner"
      ],
      "additionalProperties": false
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      },
      "minItems": 0
    },
    "design": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2,
          "type": "integer"
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/module"
          },
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "top": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "rules": {
          "$ref": "#/$defs/rules"
        },
        "waivers": {
          "$ref": "#/$defs/waivers"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
        },
        "library": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "accessories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "assembly": {
                "enum": [
                  "fitted",
                  "dnp"
                ]
              }
            },
            "required": [
              "id",
              "description",
              "quantity",
              "assembly"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "id",
        "name",
        "library",
        "modules",
        "top"
      ],
      "additionalProperties": false
    }
  }
}
